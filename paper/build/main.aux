\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Signed localization of the SPT quadratic part of each audit (\cref  {eq:signed_alloc,eq:block_dchi}) by spectrum and multipole band. Columns are bands starting at the indicated $\ell $, each extending to the next (the last band covers $3000\le \ell <4000$). Red cells add to the mismatch and blue cells reduce it; each panel has its own symmetric color scale. The title gives the total SPT quadratic difference $\Delta Q$. Cells sum exactly to it, apart from bins below $\ell =400$, which are reported separately ($2.0$ in the SPT+DESI 2018-given-D1 panel and below $0.05$ elsewhere). The numbers are allocations of one correlated quadratic form, not independent chi-squares.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:localization}{{3}{11}{Signed localization of the SPT quadratic part of each audit (\cref {eq:signed_alloc,eq:block_dchi}) by spectrum and multipole band. Columns are bands starting at the indicated $\ell $, each extending to the next (the last band covers $3000\le \ell <4000$). Red cells add to the mismatch and blue cells reduce it; each panel has its own symmetric color scale. The title gives the total SPT quadratic difference $\Delta Q$. Cells sum exactly to it, apart from bins below $\ell =400$, which are reported separately ($2.0$ in the SPT+DESI 2018-given-D1 panel and below $0.05$ elsewhere). The numbers are allocations of one correlated quadratic form, not independent chi-squares}{figure.3}{}}
\newlabel{fig:localization@cref}{{[figure][3][]3}{[1][10][]11}{}{}{}}
