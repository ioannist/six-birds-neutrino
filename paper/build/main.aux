\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Profiled localization heatmaps for the SPT lens swap, decomposing the directional held-out mismatch into contributions grouped by spectrum type and multipole ranges. \textbf  {Left:} $\Delta \chi ^2_{B|A}$ (SPT D1 given SPT2018). \textbf  {Right:} $\Delta \chi ^2_{A|B}$ (SPT2018 given SPT D1). Darker regions indicate larger contributions to the held-out failure. In both directions, the dominant contributions arise from TT at high multipoles within the overlap region.}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:profiled-localization}{{1}{10}{Profiled localization heatmaps for the SPT lens swap, decomposing the directional held-out mismatch into contributions grouped by spectrum type and multipole ranges. \textbf {Left:} $\dchi _{B|A}$ (SPT D1 given SPT2018). \textbf {Right:} $\dchi _{A|B}$ (SPT2018 given SPT D1). Darker regions indicate larger contributions to the held-out failure. In both directions, the dominant contributions arise from TT at high multipoles within the overlap region}{figure.1}{}}
